generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}


enum EstadoAgendamento {
  SOLICITADO
  PENDENTE_PAGAMENTO
  CONFIRMADO
  RECUSADO
  EXPIRADO
  CANCELADO
  REMARCADO
}

enum EstadoPagamento {
  PENDENTE
  CONFIRMADO
  FALHOU
  CANCELADO
  REEMBOLSADO
}

enum EstadoSessao {
  AGENDADA
  EM_ANDAMENTO
  CONCLUIDA
  FALTOU
  CANCELADA
}

model Agendamento {
  agendamento_id String @id @default(uuid())

  modo_sessao Int @default(0)

  psicologo_id String?
  psicologo Psicologo? @relation("AgendamentosPsicologo", fields: [psicologo_id], references: [user_id], onDelete: SetNull)

  paciente_id String
  paciente Paciente @relation(fields: [paciente_id], references: [user_id])

  data DateTime @db.Date
  horaInicio DateTime @db.Time(0)
  horaFim DateTime @db.Time(0)
  duracaoMinutos Int @default(45)
  observacao String? @db.VarChar(500)

  estado EstadoAgendamento @default(SOLICITADO)

  valor String?

  expiracaoReserva DateTime?

  pagamentos Pagamento[]
  sessao Sessao?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([psicologo_id])
  @@index([estado])
  @@map("agendamentos")
}


model Psicologo {
  user_id       String            @id @map("user_id")
  bio           String?           @db.VarChar(500)
  createdAt     DateTime          @default(now())
  numero_ordem  String            @unique
  especialidade String?           @db.VarChar(255)
  sexo          Int?
  nacionalidade String?
  ano_experiencia Int?
  isLogged               Int?  @default(0)    @map("is_logged")
  nbi             String?
  idiomas        String?
  contacto      String?
  updatedAt     DateTime          @default(now())
  status        Int               @default(2)
  agendamentos Agendamento[]      @relation("AgendamentosPsicologo")
  avaliacao     Avaliacao[]       @relation("Avaliacao_recebida")
  posts         Post[]
  user          User              @relation(fields: [user_id], references: [id])
  paciente_psicologo PacientePsicologo[]
  laudo Laudo[]
  relatorio Relatorio[]
  @@map("psicologos")
}

model Post {
  post_id      String     @id @default(uuid())
  psicologo_id String?
  content      String
  photoUrl     String?
  likes        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  hastags      String
  psicologo    Psicologo? @relation(fields: [psicologo_id], references: [user_id])

  @@map("posts")
}
model Avaliacao {
  star_id      String    @id @default(uuid())
  observacao   String    @db.VarChar(255)
  psicologo_id String    @map("psicologo_id")
  paciente_id  String    @map("paciente_id")
  paciente     Paciente  @relation("Avaliacao_feita", fields: [paciente_id], references: [user_id], onDelete: Cascade)
  psicologo    Psicologo @relation("Avaliacao_recebida", fields: [psicologo_id], references: [user_id], onDelete: Cascade)

  @@map("avaliacoes")
}


model Sessao {
  sessao_id String @id @default(uuid())

  agendamento_id String @unique

  agendamento Agendamento @relation(fields: [agendamento_id], references: [agendamento_id], onDelete: Restrict)

  status EstadoSessao @default(AGENDADA)

  inicio DateTime?
  fim DateTime?
  extra_data Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessoes")
}



model Pagamento {
  pagamento_id String @id @default(uuid())

  agendamento_id String
  agendamento Agendamento @relation(fields: [agendamento_id], references: [agendamento_id], onDelete: Restrict)

  valor Decimal @db.Decimal(10, 2)

  estado EstadoPagamento @default(PENDENTE)

  metodoPagamento String?
  referencia String? @unique

  dataPagamento DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agendamento_id])
  @@map("pagamentos")
}


// paciente

model Paciente {
  user_id   String      @id @map("user_id")
  idade     Int?
  nbi String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now())
  telefone  String?
  avaliacao Avaliacao[] @relation("Avaliacao_feita")
  agendamentos Agendamento[]
  user      User        @relation(fields: [user_id], references: [id])
  triagem   Triagem?
  laudo Laudo[]
  relatorio Relatorio[]
  paciente_psicologo PacientePsicologo[]
  @@map("pacientes")
}

model Triagem {
  id          String   @id @default(uuid())
  respostas   String
  createdAt   DateTime @default(now())
  updatedAt DateTime    @default(now())
  paciente_id String   @unique
  paciente    Paciente @relation(fields: [paciente_id], references: [user_id])
  @@map("triagens")
}

model Relatorio{
  relatorio_id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt DateTime    @default(now())
  paciente_id String   
  psicologo_id String 
  demanda String 
  procedimentos String 
  analises String 
  conclusao String
  assinatura String?
  local_atendimento String?
  paciente     Paciente @relation(fields: [paciente_id], references: [user_id])
  psicologo    Psicologo @relation(fields: [psicologo_id], references: [user_id])
  @@map("relatorios")
}

model Laudo{
  laudo_id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt DateTime    @default(now())
  paciente_id String   
  psicologo_id String   
  objetivo String 
  resultado String 
  discussao String 
  conclusao String
  assinatura String?
  historico String
  paciente    Paciente @relation(fields: [paciente_id], references: [user_id])
  psicologo    Psicologo @relation(fields: [psicologo_id], references: [user_id])
  @@map("laudos")
}

model Mensagem {
  mensagem_id String @id @default(uuid())

  remetente_id String
  destinatario_id String

  remetente User @relation("MensagensEnviadas", fields: [remetente_id], references: [id])

  destinatario User @relation("MensagensRecebidas", fields: [destinatario_id], references: [id])

  conteudo String? @db.Text
  file String?

  lida Boolean @default(false)
  dataLeitura DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mensagens")
}

// sistema
model User {
  id                 String              @id @default(uuid())
  nome               String              @db.VarChar(255)
  sobrenome          String              @db.VarChar(255)
  password           String
  photo              String?
  email              String              @unique(map: "email") @db.VarChar(255)
  role               Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now())
  refreshToken       RefreshToken[]
  notificacoes UserNotificacao[]
  paciente           Paciente?
  passwordResetCodes PasswordResetCode[]
  psicologo          Psicologo?
  mensagensEnviadas  Mensagem[] @relation("MensagensEnviadas")
  mensagensRecebidas Mensagem[] @relation("MensagensRecebidas")
  @@map("users")
}

model PasswordResetCode {
  pass_id   String   @id @default(uuid())
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user_id   String
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([code])
  @@map("password_codes")
}

model Logatividade {
  log_id   String   @id @default(uuid())
  user_id  String
  tipo     Int
  mensagem String
  data     DateTime @default(now())

  @@map("logs")
}

model PacientePsicologo {
  id          String      @id @default(uuid())
  paciente_id   String      
  psicologo_id String      
  ativo       Boolean  @default(true) 
  createdAt    DateTime @default(now()) 
  encerradoEm DateTime?   
  paciente     Paciente  @relation(fields: [paciente_id], references: [user_id])
  psicologo    Psicologo @relation(fields: [psicologo_id], references: [user_id])

  @@map("PacientePsicologo")
}

model RefreshToken {
  token_id   String @id @default(uuid())
  expiresIn  Int
  refresh    String  @unique
  user_id    String
  user_agent String
  ip         String
  user       User   @relation(fields: [user_id], references: [id])
}

model Notificacao {
  not_id    String   @id @default(uuid())
  mensagem  String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  notificacoes UserNotificacao[]
  @@map("notificacoes")
}
model UserNotificacao {
  notification_id    String   @id @default(uuid())
  user_id   String
  not_id String
  notificacao Notificacao @relation(fields: [not_id], references: [not_id], onDelete: Cascade)
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("Usernotificacoes")
}
